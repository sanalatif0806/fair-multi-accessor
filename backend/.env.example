GEMINI_API_KEY=AQ.Ab8RN6Jv4FDu4hYx5Zh1X0eQ3x-RsWS2oTfm6B9cIMMz8ias0A
GEMINI_MODEL=gemini-3.1-flash-lite




# F-UJI has no public API; point this at your running fuji_server instance
